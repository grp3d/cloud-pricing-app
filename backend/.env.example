# Backend configuration template (016-canvas-icon-layout, FR-027). Copy to `backend/.env` and
# uncomment what you need; every value shown is the default. Full reference:
# docs/configuration.md

# DATABASE_URL=postgresql+psycopg://localhost/cloud_pricing_dev

# Required: the pricing pipeline's storage root (holds aws/manifests/ and aws/parquet/), local or
# s3://bucket[/prefix]. AWS_PRICING_PARQUET_DIR was removed; setting it stops startup.
PRICING_DATA_URI=file:///path/to/DATA/pipeline
# S3 sources only: the verified local copy of the active snapshot.
# PRICING_CACHE_DIR=/tmp/cloud-pricing-cache
# PRICING_CACHE_MAX_BYTES=1073741824
# PRICING_CACHE_KEEP=1
# DuckDB limits for each pricing query.
# DUCKDB_MEMORY_LIMIT=512MB
# DUCKDB_THREADS=2
# AWS_PRICING_REGION=us-east-1

# Background pricing-snapshot check interval (seconds, >= 10).
# SNAPSHOT_CHECK_INTERVAL_SECONDS=300
# Pin the active pricing snapshot (YYYY-MM-DD); unset = the one latest.json names.
# ACTIVE_SNAPSHOT_DATE=

# CORS_ALLOWED_ORIGINS=["http://localhost:5173"]
# CATALOG_SEARCH_DEFAULT_LIMIT=50
# CATALOG_SEARCH_MAX_LIMIT=200
# PASSWORD_HASH_ITERATIONS=260000
# LOG_LEVEL=INFO
# Log output format: json (default, one JSON object per line) or console (colored, readable; local development only)
# LOG_FORMAT=json
