# Settings for the local packaged stack (018-app-cloud-deployment, Story 8). Copy to .env.local
# (git-ignored) and set LOCAL_DATA_ROOT. Used with:
#   docker compose --env-file .env.local -f compose.yaml -f compose.local.yaml up --build

# A pipeline storage root on this laptop (holds aws/manifests/ and aws/parquet/). The committed
# test fixture works: <repo>/backend/tests/fixtures/pricing_parquet
LOCAL_DATA_ROOT=/path/to/DATA/pipeline

BACKEND_IMAGE=cloud-pricing-app-backend:local
WEB_IMAGE=cloud-pricing-app-web:local
PUBLIC_ADDRESS=localhost
HTTPS_PORT=8443
APP_ENVIRONMENT=local
APP_RELEASE=local

# A local-only database password; the cloud generates one at every boot.
POSTGRES_PASSWORD=local-only-password
DATABASE_URL=postgresql+psycopg://app:local-only-password@db:5432/cloud_pricing

# A fresh local database keeps the default Admin password (admin123). Change it in the app.
DB_INIT_ARGS=--allow-default-admin-password
